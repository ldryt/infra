    {
      "id": 10,
      "title": "Leap second status",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "description": "This is the leap status, which can be Normal, Insert a second, Delete a second or Not synchronised.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_ntp_leap{job=\"nodes\",instance=\"$instance\"}",
          "format": "time_series",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "type": "stat",
      "options": {
        "reduceOptions": {
          "calcs": [
