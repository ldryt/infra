{
  "uid": "sadlil-loki-apps-dashboard",
  "title": "Logs",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "version": 16,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "query": {
          "type": 1,
          "label": "host",
          "stream": "{job=\"systemd-journal\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "priority",
        "label": "Priority",
        "type": "custom",
        "query": "Any : .*, Warning and above : [0-4], Error and above : [0-3]",
        "current": {
          "text": "Any",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Journal logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{job=\"systemd-journal\", host=~\"${host:regex}\"} | json message=\"MESSAGE\", unit=\"_SYSTEMD_UNIT\", identifier=\"SYSLOG_IDENTIFIER\", priority=\"PRIORITY\" | priority=~\"${priority:raw}\" | line_format `{{.host}}{{if .unit}} {{.unit}}{{else if .identifier}} {{.identifier}}{{end}} {{if .message}}{{.message}}{{else}}{{ __line__ }}{{end}}`",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ]
}
