{
  "uid": "sadlil-loki-apps-dashboard",
  "title": "Logs",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "version": 17,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "query": {
          "type": 1,
          "label": "host",
          "stream": "{job=\"systemd-journal\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "unit",
        "label": "Systemd unit",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "query": {
          "type": 1,
          "label": "unit",
          "stream": "{job=\"systemd-journal\", host=~`${host:regex}`}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allowCustomValue": true
      },
      {
        "name": "priority",
        "label": "Priority",
        "type": "custom",
        "query": "All : .*, Warnings and worse : [0-4], Errors and worse : [0-3], Emergency : 0, Alert : 1, Critical : 2, Error : 3, Warning : 4, Notice : 5, Info : 6, Debug : 7",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "search",
        "label": "Search logs",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Journal logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "{job=\"systemd-journal\", host=~`${host:regex}`} | json message=\"MESSAGE\", journal_unit=\"_SYSTEMD_UNIT\", identifier=\"SYSLOG_IDENTIFIER\", priority=\"PRIORITY\" | priority=~\"${priority:raw}\" | label_format systemd_unit=`{{ default .journal_unit .unit }}` | systemd_unit=~`${unit:regex}` | line_format `{{.host}}{{if .systemd_unit}} {{.systemd_unit}}{{else if .identifier}} {{.identifier}}{{end}} {{if .message}}{{.message}}{{else}}{{ __line__ }}{{end}}` | label_format search_match=`{{ contains (lower (urldecode \"${search:percentencode}\")) (lower (__line__)) }}` | search_match=\"true\" | drop search_match",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ]
}
