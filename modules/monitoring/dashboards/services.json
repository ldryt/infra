    {
      "id": 21,
      "title": "Host resources",
      "type": "table",
      "description": "One row per host enrolled in Node Exporter. CPU busy is the share of CPU time outside idle over five minutes. Memory pressure is the share of time at least one task waited for memory over five minutes. System disk free uses the local root filesystem, or /nix when root is in memory. A missing scrape leaves the resource cells blank.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": true,
          "range": false,
          "expr": "label_replace((max by (instance) (up{job=\"nodes\"})), \"host_measure\", \"Metrics\", \"instance\", \".+\")\n or label_replace(((100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"nodes\",mode=\"idle\"}[5m])))) and on (instance) (up{job=\"nodes\"} == 1)), \"host_measure\", \"CPU busy\", \"instance\", \".+\")\n or label_replace(((100 * max by (instance) (rate(node_pressure_memory_waiting_seconds_total{job=\"nodes\"}[5m]))) and on (instance) (up{job=\"nodes\"} == 1)), \"host_measure\", \"Memory pressure\", \"instance\", \".+\")\n or label_replace(((max by (instance) (node_filesystem_avail_bytes{job=\"nodes\",mountpoint=\"/\",fstype!~\"tmpfs|ramfs|overlay|autofs|fuse.*|nfs.*|cifs\"}) or on (instance) max by (instance) (node_filesystem_avail_bytes{job=\"nodes\",mountpoint=\"/nix\",fstype!~\"tmpfs|ramfs|overlay|autofs|fuse.*|nfs.*|cifs\"})) and on (instance) (up{job=\"nodes\"} == 1)), \"host_measure\", \"System disk free\", \"instance\", \".+\")"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "host_measure"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "instance": 0,
              "Metrics": 1,
              "CPU busy": 2,
              "Memory pressure": 3,
              "System disk free": 4
            },
            "renameByName": {
              "instance": "Host"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Metrics"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Missing",
                        "color": "orange"
                      },
                      "1": {
                        "text": "Reporting",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU busy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory pressure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "System disk free"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Host details",
                    "url": "/d/rYdddlPWk?var-job=nodes&var-node=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Host",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 1,
      "title": "Chrony",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Synchronization",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 5,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "(chrony_tracking_stratum{job=\"chrony\"} > bool 0) * (chrony_tracking_stratum{job=\"chrony\"} < bool 16)",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unsynchronized",
                  "color": "red"
                },
                "1": {
                  "text": "Synchronized",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "Chrony reports the clock’s NTP stratum. A stratum from 1 to 15 indicates synchronization. If the clock is unsynchronized, the time this server provides may be inaccurate.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Clock error",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 5,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "chrony_tracking_rms_offset_seconds{job=\"chrony\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "description": "The root mean square (RMS) offset estimates the typical size of the gap between the clock and its reference time. Lower values are better. A sustained rise means the clock is drifting farther from its reference or its timing measurements are becoming noisier.",
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "NTP requests per second",
      "description": "Rate of incoming NTP packets, including any that Chrony drops. The large number is the average rate over the selected time range. The sparkline shows changes in incoming load. The rate uses at least four minutes of samples.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 17,
        "y": 8,
        "w": 7,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "rate(chrony_serverstats_ntp_packets_received_total{job=\"chrony\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "title": "Time sources",
      "type": "table",
      "description": "Each row shows an upstream Chrony source. Selection describes whether Chrony uses it to set the clock. Recent replies shows the fraction of the last eight polls with valid replies. An unusable source can still answer every poll. Run chronyc -N selectdata for the reason Chrony excluded a source.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "chrony_sources_state_info{job=\"chrony\"} * on (instance, source_address) group_left() chrony_sources_reachability_ratio{job=\"chrony\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Selection"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "sync": {
                        "text": "Selected",
                        "color": "green"
                      },
                      "combined": {
                        "text": "Combined",
                        "color": "green"
                      },
                      "outlier": {
                        "text": "Not selected",
                        "color": "yellow"
                      },
                      "unreach": {
                        "text": "Unusable",
                        "color": "orange"
                      },
                      "falsetick": {
                        "text": "Falseticker",
                        "color": "orange"
                      },
                      "jittery": {
                        "text": "Too variable",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Recent replies"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Recent replies",
            "desc": false
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "source_mode": true,
              "source_address": true
            },
            "indexByName": {
              "source_name": 0,
              "source_state": 1,
              "Value": 2,
              "instance": 3
            },
            "renameByName": {
              "source_name": "Source",
              "source_state": "Selection",
              "Value": "Recent replies",
              "instance": "Host"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "NTP Pool",
      "type": "row",
