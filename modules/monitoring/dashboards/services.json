    {
      "id": 63,
      "title": "Snowflake connections",
      "description": "Estimated successful connections completed during the selected period, summed across countries. The counter starts with the first completed connection.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "sum(increase(tor_snowflake_proxy_connections_total[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "Completed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
