    {
      "id": 7,
      "title": "NTP Pool score",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "(label_replace(last_over_time(ntppool_score{job=\"ntppool\",instance=\"domus\"}[15m]), \"observation_field\", \"Score\", \"instance\", \".+\")) or (label_replace(1000 * last_over_time(ntppool_score_timestamp_seconds{job=\"ntppool\",instance=\"domus\"}[15m]), \"observation_field\", \"Evaluated at\", \"instance\", \".+\"))",
          "instant": false,
          "range": true,
          "interval": "5m",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "pointSize": 7,
            "lineWidth": 1,
            "axisSoftMax": 21
          }
        },
        "overrides": []
      },
      "description": "Each dot is one NTP Pool evaluation at the time recorded by the Pool. Repeated scrapes of the same evaluation are combined into one dot. Lines connect consecutive evaluations. Hover over a dot to see its time and score. The maximum score is 20, and the low-score alert threshold is 10.",
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "maxDataPoints": 10080,
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "observation_field"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Evaluated at": {
                "operation": "groupby",
                "aggregations": []
              },
              "Score": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              }
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Evaluated at",
                "destinationType": "time"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Evaluated at",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Score (lastNotNull)": "Score"
            }
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "DNS answer share",
      "description": "Global is the worldwide share of Pool DNS answers containing this server’s address. The next five rows are the regions with the largest share within that region, ordered by share. The percentages have different denominators. NTP requests per second shows the packets that actually reached this server.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 14,
        "y": 24,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "label_replace(label_replace((last_over_time(ntppool_dns_answer_points{job=\"ntppool-dns\", country=\"\"}[15m]) / 10000), \"region\", \"Global\", \"instance\", \".+\"), \"display_order\", \"0\", \"instance\", \".+\") or label_replace(label_replace(topk by (instance) (5, last_over_time(ntppool_dns_answer_points{job=\"ntppool-dns\", country!=\"\"}[15m]) / 10000), \"region\", \"$1\", \"country\", \"(.+)\"), \"display_order\", \"1\", \"instance\", \".+\")",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Answer share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "instance",
                "desc": false
              },
              {
                "field": "display_order",
                "desc": false
              },
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "country": true,
              "display_order": true
            },
            "indexByName": {
              "region": 0,
              "Value": 1,
              "instance": 2
            },
            "renameByName": {
              "region": "Region",
              "Value": "Answer share",
              "instance": "Host"
            }
          }
        }
      ]
    },
