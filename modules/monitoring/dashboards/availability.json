{
  "uid": "availability",
  "title": "Availability",
  "description": "Service checks from domus.",
  "schemaVersion": 39,
  "version": 6,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Services",
      "url": "/d/services"
    }
  ],
  "panels": [
    {
      "id": 3,
      "title": "Status",
      "description": "Checks run from domus, not from the public internet.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "count((probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} == 1) and (up == 1)) or 0 * count(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"})",
          "legendFormat": "Passing",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "count((probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} == 0) and (up == 1)) or 0 * count(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"})",
          "legendFormat": "Failing",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "count(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} unless (probe_success and (up == 1))) or 0 * count(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"})",
          "legendFormat": "Unknown",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failing" },
            "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }, { "color": "red", "value": 1 }] } }]
          },
          {
            "matcher": { "id": "byName", "options": "Unknown" },
            "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }, { "color": "orange", "value": 1 }] } }]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 1,
      "title": "Uptime",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "description": "Uptime counts only checks that returned a result. Coverage shows how often we got one.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} and (up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} == 1)) or (up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} * 0 + 2)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Status",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "B",
          "expr": "100 * avg_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[24h])",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "24h",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "C",
          "expr": "100 * avg_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[7d])",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "7d",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "D",
          "expr": "100 * avg_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[30d])",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "30d",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "E",
          "expr": "100 * clamp_max((count_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[30d]) or up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} * 0) / 43200, 1)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Coverage",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "/^(instance|Value.*)$/"
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            },
            "renameByName": {
              "instance": "Endpoint",
              "Value #A": "Status",
              "Value #B": "24h uptime",
              "Value #C": "7d uptime",
              "Value #D": "30d uptime",
              "Value #E": "30d coverage"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": { "minWidth": 90 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Endpoint" },
            "properties": [{ "id": "custom.width", "value": 350 }]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Down",
                        "color": "red"
                      },
                      "1": {
                        "text": "Up",
                        "color": "green"
                      },
                      "2": {
                        "text": "Unknown",
                        "color": "gray"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/(uptime|coverage)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Endpoint",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Check history",
      "type": "status-history",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[$__interval]) == 0) or ((min_over_time(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[$__interval]) == bool 0) * 2 == 2) or min_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[$__interval])",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "interval": "1m",
      "maxDataPoints": 144,
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "2": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "gray",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "colWidth": 0.9,
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
