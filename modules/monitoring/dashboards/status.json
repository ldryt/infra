{
  "uid": "status",
  "title": "Status",
  "description": "Availability checks from domus, host health, and service metrics.",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "version": 20,
  "panels": [
    {
      "id": 3,
      "title": "Status",
      "description": "Checks run from domus, not from the public internet.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "count((probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} == 1) and (up == 1)) or 0 * count(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"})",
          "legendFormat": "Passing",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "count((probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} == 0) and (up == 1)) or 0 * count(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"})",
          "legendFormat": "Failing",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "count(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} unless (probe_success and (up == 1))) or 0 * count(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"})",
          "legendFormat": "Unknown",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failing" },
            "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }, { "color": "red", "value": 1 }] } }]
          },
          {
            "matcher": { "id": "byName", "options": "Unknown" },
            "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }, { "color": "orange", "value": 1 }] } }]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 1,
      "title": "Uptime",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "description": "Uptime counts only checks that returned a result. Coverage shows how often we got one.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} and (up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} == 1)) or (up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} * 0 + 2)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Status",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "B",
          "expr": "100 * avg_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[24h])",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "24h",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "C",
          "expr": "100 * avg_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[7d])",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "7d",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "D",
          "expr": "100 * avg_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[30d])",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "30d",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "refId": "E",
          "expr": "100 * clamp_max((count_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[30d]) or up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"} * 0) / 43200, 1)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Coverage",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "/^(instance|Value.*)$/"
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            },
            "renameByName": {
              "instance": "Endpoint",
              "Value #A": "Status",
              "Value #B": "24h uptime",
              "Value #C": "7d uptime",
              "Value #D": "30d uptime",
              "Value #E": "30d coverage"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": { "minWidth": 90 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Endpoint" },
            "properties": [{ "id": "custom.width", "value": 350 }]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Down",
                        "color": "red"
                      },
                      "1": {
                        "text": "Up",
                        "color": "green"
                      },
                      "2": {
                        "text": "Unknown",
                        "color": "gray"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/(uptime|coverage)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Endpoint",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Check history",
      "type": "status-history",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[$__interval]) == 0) or ((min_over_time(up{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[$__interval]) == bool 0) * 2 == 2) or min_over_time(probe_success{job=~\"blackbox_.+\",job!=\"blackbox_tcp_fail\"}[$__interval])",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "interval": "1m",
      "maxDataPoints": 144,
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "2": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "gray",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "colWidth": 0.9,
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 20,
      "title": "Hosts",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "title": "Host resources",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": true,
          "range": false,
          "expr": "label_replace((max by (instance) (up{job=\"nodes\"})), \"host_measure\", \"Metrics\", \"instance\", \".+\")\n or label_replace(((100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"nodes\",mode=\"idle\"}[5m])))) and on (instance) (up{job=\"nodes\"} == 1)), \"host_measure\", \"CPU busy\", \"instance\", \".+\")\n or label_replace(((100 * max by (instance) (rate(node_pressure_memory_waiting_seconds_total{job=\"nodes\"}[5m]))) and on (instance) (up{job=\"nodes\"} == 1)), \"host_measure\", \"Memory pressure\", \"instance\", \".+\")\n or label_replace(((max by (instance) (node_filesystem_avail_bytes{job=\"nodes\",mountpoint=\"/\",fstype!~\"tmpfs|ramfs|overlay|autofs|fuse.*|nfs.*|cifs\"}) or on (instance) max by (instance) (node_filesystem_avail_bytes{job=\"nodes\",mountpoint=\"/nix\",fstype!~\"tmpfs|ramfs|overlay|autofs|fuse.*|nfs.*|cifs\"})) and on (instance) (up{job=\"nodes\"} == 1)), \"host_measure\", \"System disk free\", \"instance\", \".+\")"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "host_measure"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "instance": 0,
              "Metrics": 1,
              "CPU busy": 2,
              "Memory pressure": 3,
              "System disk free": 4
            },
            "renameByName": {
              "instance": "Host"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Metrics"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Missing",
                        "color": "orange"
                      },
                      "1": {
                        "text": "Reporting",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU busy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory pressure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "System disk free"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Host details",
                    "url": "/d/rYdddlPWk?var-job=nodes&var-node=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Host",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 77,
      "title": "NTP",
      "type": "row",
      "collapsed": true,
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 1 },
      "panels": [
        {
          "id": 78,
          "title": "Clock sync",
          "type": "stat",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "gridPos": { "x": 0, "y": 38, "w": 5, "h": 8 },
          "targets": [
            { "refId": "A", "expr": "(chrony_tracking_stratum{job=\"chrony\"} > bool 0) * (chrony_tracking_stratum{job=\"chrony\"} < bool 16)", "instant": true, "range": false }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                { "type": "value", "options": { "0": { "text": "Not synced", "color": "red" }, "1": { "text": "Synced", "color": "green" } } }
              ]
            },
            "overrides": []
          },
          "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
        },
        {
          "id": 4,
          "title": "Clock offset",
          "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "gridPos": { "x": 5, "y": 38, "w": 9, "h": 8 },
          "targets": [
            { "refId": "A", "expr": "chrony_tracking_rms_offset_seconds{job=\"chrony\"}", "legendFormat": "Offset", "range": true, "instant": false }
          ],
          "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
          "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
        },
        {
          "id": 7,
          "title": "Pool score",
          "description": "The NTP Pool scores up to 20. A score below 10 for 30 minutes triggers an alert.",
          "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "gridPos": { "x": 14, "y": 38, "w": 10, "h": 8 },
          "targets": [
            {
              "refId": "A",
              "expr": "(label_replace(last_over_time(ntppool_score{job=\"ntppool\",instance=\"domus\"}[15m]), \"observation_field\", \"Score\", \"instance\", \".+\")) or (label_replace(1000 * last_over_time(ntppool_score_timestamp_seconds{job=\"ntppool\",instance=\"domus\"}[15m]), \"observation_field\", \"Evaluated at\", \"instance\", \".+\"))",
              "instant": false,
              "range": true,
              "interval": "5m",
              "format": "time_series"
            }
          ],
          "fieldConfig": {
            "defaults": { "min": 0, "custom": { "showPoints": "always", "pointSize": 7, "lineWidth": 1, "axisSoftMax": 21 } },
            "overrides": []
          },
          "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
          "maxDataPoints": 10080,
          "transformations": [
            { "id": "labelsToFields", "options": { "mode": "columns", "valueLabel": "observation_field" } },
            { "id": "merge", "options": {} },
            {
              "id": "groupBy",
              "options": {
                "fields": {
                  "Evaluated at": { "operation": "groupby", "aggregations": [] },
                  "Score": { "operation": "aggregate", "aggregations": ["lastNotNull"] }
                }
              }
            },
            { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "Evaluated at", "destinationType": "time" }] } },
            { "id": "sortBy", "options": { "sort": [{ "field": "Evaluated at", "desc": false }] } },
            { "id": "organize", "options": { "renameByName": { "Score (lastNotNull)": "Score" } } }
          ]
        },
        {
          "id": 5,
          "title": "NTP requests",
          "description": "Average rate over the selected time range.",
          "type": "stat",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "gridPos": { "x": 0, "y": 46, "w": 12, "h": 8 },
          "targets": [
            { "refId": "A", "expr": "rate(chrony_serverstats_ntp_packets_received_total{job=\"chrony\"}[$__rate_interval])", "range": true, "instant": false, "interval": "1m" }
          ],
          "fieldConfig": { "defaults": { "unit": "suffix: req/s", "min": 0, "decimals": 0 }, "overrides": [] },
          "options": {
            "colorMode": "none",
            "graphMode": "area",
            "textMode": "value",
            "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }
          }
        },
        {
          "id": 15,
          "title": "Pool DNS share by region",
          "description": "Share of NTP Pool DNS answers that include domus, not a count of clients.",
          "type": "table",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "gridPos": { "x": 12, "y": 46, "w": 12, "h": 8 },
          "targets": [
            {
              "refId": "A",
              "expr": "label_replace(label_replace(last_over_time(ntppool_dns_answer_points{job=\"ntppool-dns\",country=\"\"}[15m]) / 10000, \"region\", \"Global\", \"instance\", \".+\"), \"display_order\", \"0\", \"instance\", \".+\") or label_replace(label_replace(topk by (instance) (5, last_over_time(ntppool_dns_answer_points{job=\"ntppool-dns\",country!=\"\"}[15m]) / 10000), \"region\", \"$1\", \"country\", \"(.+)\"), \"display_order\", \"1\", \"instance\", \".+\")",
              "instant": true,
              "range": false,
              "format": "table"
            }
          ],
          "fieldConfig": {
            "defaults": {},
            "overrides": [
              { "matcher": { "id": "byName", "options": "DNS share" }, "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 3 }] }
            ]
          },
          "options": { "showHeader": true },
          "transformations": [
            { "id": "labelsToFields", "options": { "mode": "columns" } },
            { "id": "merge", "options": {} },
            { "id": "sortBy", "options": { "sort": [{ "field": "display_order", "desc": false }, { "field": "Value", "desc": true }] } },
            {
              "id": "organize",
              "options": {
                "excludeByName": { "Time": true, "job": true, "instance": true, "country": true, "display_order": true },
                "indexByName": { "region": 0, "Value": 1 },
                "renameByName": { "region": "Region", "Value": "DNS share" }
              }
            }
          ]
        }
      ]
    },
    {
      "id": 62,
      "title": "Snowflake",
      "type": "row",
      "collapsed": true,
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 1 },
      "panels": [
        {
          "id": 63,
          "title": "Connections in the last hour",
          "description": "Timeouts can happen on the client side, too.",
          "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "gridPos": { "x": 0, "y": 39, "w": 12, "h": 7 },
          "targets": [
            { "refId": "A", "expr": "sum(increase(tor_snowflake_proxy_connections_total{job=\"snowflake\"}[1h]))", "legendFormat": "Successful", "range": true, "instant": false },
            { "refId": "B", "expr": "sum(increase(tor_snowflake_proxy_connection_timeouts_total{job=\"snowflake\"}[1h]))", "legendFormat": "Timed out", "range": true, "instant": false }
          ],
          "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "custom": { "showPoints": "never" } }, "overrides": [] },
          "options": { "tooltip": { "mode": "multi" } }
        },
        {
          "id": 72,
          "title": "Traffic relayed",
          "description": "Rolling three-hour totals. Snowflake reports traffic once an hour.",
          "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "gridPos": { "x": 12, "y": 39, "w": 12, "h": 7 },
          "targets": [
            { "refId": "A", "expr": "1000 * increase(tor_snowflake_proxy_traffic_inbound_bytes_total{job=\"snowflake\"}[3h])", "legendFormat": "To clients", "range": true, "instant": false },
            { "refId": "B", "expr": "1000 * increase(tor_snowflake_proxy_traffic_outbound_bytes_total{job=\"snowflake\"}[3h])", "legendFormat": "From clients", "range": true, "instant": false }
          ],
          "fieldConfig": { "defaults": { "unit": "decbytes", "min": 0, "custom": { "showPoints": "never" } }, "overrides": [] },
          "options": { "tooltip": { "mode": "multi" } }
        }
      ]
    },
    {
      "id": 48,
      "title": "Mail",
      "type": "row",
      "collapsed": true,
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 },
      "panels": [
        {
          "id": 49,
          "title": "Postfix queues",
          "description": "Deferred messages are waiting for another delivery attempt.",
          "type": "timeseries",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "gridPos": { "x": 0, "y": 40, "w": 24, "h": 7 },
