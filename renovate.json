{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nix", "terraform", "github-actions", "custom.regex"],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:version|tag|\\w+Version)\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\s+image\\s*=\\s*\"[^\"]*:(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\";"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=git-refs depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\s+(?:rev|revision|\\w+Revision)\\s*=\\s*\"(?<currentDigest>[a-f0-9]{40})\";"
      ],
      "datasourceTemplate": "git-refs"
    }
  ]
}
