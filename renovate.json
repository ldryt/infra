{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nix", "terraform", "github-actions", "custom.regex"],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:version|tag)\\s*=\\s*\"(?<currentValue>[^\"]+)\";",
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\s+image\\s*=\\s*\"[^\"]*:(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\";",
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\s+(?:rev|revision)\\s*=\\s*\"(?<currentDigest>[a-f0-9]{40})\";"
      ]
    }
  ]
}
