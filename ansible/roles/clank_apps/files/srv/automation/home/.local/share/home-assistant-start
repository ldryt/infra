#!/bin/sh
set -eu
# HA 2026.11.0 / Bellows 1.2.1: keep the EZSP version in sync after reset.
patch=/usr/local/share/bellows-ezsp-reset.patch
git -C /usr/local/lib/python3.14/site-packages apply --reverse --check "$patch" 2>/dev/null ||
    git -C /usr/local/lib/python3.14/site-packages apply "$patch"
exec /init "$@"
