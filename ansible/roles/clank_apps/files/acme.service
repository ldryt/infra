[Unit]
Description=Issue and renew automation certificate

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=DESEC_TOKEN_FILE=%h/.config/acme/desec-token
UMask=0077
# Host recursive DNS failed DNS-01 propagation; this resolver passed full staging issuance.
ExecStart=/usr/bin/lego run --email security@ldryt.dev --domains ha.ldryt.dev --dns desec --dns.resolvers 1.1.1.1:53 --accept-tos --deploy-hook "/usr/bin/systemctl --user try-reload-or-restart gateway.service"
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=900
