[Unit]
Wants=matter.service
After=home-assistant.service matter.service
{% for port in automation_radio_ports %}
Requires=radio@{{ port }}.socket
After=radio@{{ port }}.socket
{% endfor %}
PartOf=home-assistant.service

[Container]
Image={{ automation_images.gateway }}
ContainerName=gateway
Network=internal.network
Network=edge.network
NetworkAlias=gateway
{% for host in automation_egress_hosts %}
NetworkAlias={{ host }}
{% endfor %}
PublishPort=192.168.1.3:48448:8443
UserNS=keep-id
Volume=%h/.config/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=%h/.lego/certificates:/certs:ro
Volume=%t/radio:/run/radio:ro
Volume=%t/matter:/run/matter:ro
Entrypoint=/usr/sbin/nginx
Exec=-g "daemon off;"
ReloadCmd=/bin/sh -c "nginx -t && nginx -s reload"
ReadOnly=true
Tmpfs=/var/cache/nginx:rw,size=32m,mode=1777
NoNewPrivileges=true
DropCapability=ALL
Sysctl=net.ipv4.ip_unprivileged_port_start=0

[Service]
Environment=TMPDIR=%h/.cache/tmp
Restart=on-failure
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=default.target
