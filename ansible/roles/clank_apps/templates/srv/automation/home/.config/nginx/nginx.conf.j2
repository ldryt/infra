pid /var/cache/nginx/nginx.pid;
error_log /dev/stderr;
events {}
stream {
    resolver 1.1.1.1 ipv6=off;
    map $ssl_preread_server_name $asset_upstream {
        default "";
{% for host in automation_egress_hosts %}
        {{ host }} {{ host }}:443;
{% endfor %}
    }
    server {
        listen 443;
        ssl_preread on;
        proxy_pass $asset_upstream;
        proxy_connect_timeout 10s;
        proxy_timeout 30s;
    }
{% for port in automation_radio_ports %}
    server {
        listen {{ port }};
        proxy_pass unix:/run/radio/{{ port }}.sock;
        proxy_connect_timeout 10s;
        proxy_timeout 1d;
    }
{% endfor %}
{% for device in automation_wifi_devices if device.esphome_gateway_port is defined %}
    server {
        listen {{ device.esphome_gateway_port }};
        proxy_pass {{ device.ip }}:6053;
        proxy_connect_timeout 10s;
        proxy_timeout 1d;
    }
{% endfor %}
    server {
        listen {{ automation_matter_api_port }};
        proxy_pass unix:/run/matter/api.sock;
        proxy_connect_timeout 10s;
        proxy_timeout 1d;
    }
}
http {
    access_log /dev/stdout;
    client_body_temp_path /var/cache/nginx/client_temp;
    proxy_temp_path /var/cache/nginx/proxy_temp;
    fastcgi_temp_path /var/cache/nginx/fastcgi_temp;
    uwsgi_temp_path /var/cache/nginx/uwsgi_temp;
    scgi_temp_path /var/cache/nginx/scgi_temp;
    upstream ha { server ha:8123; }
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' '';
    }
    server {
        listen 8443 ssl;
        server_name {{ automation_domain }};
        ssl_certificate /certs/{{ automation_domain }}.crt;
        ssl_certificate_key /certs/{{ automation_domain }}.key;
        client_max_body_size 100m;
        if ($host != {{ automation_domain }}) { return 444; }
        location / {
            proxy_pass http://ha;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
            proxy_set_header Forwarded "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
        }
    }
}
