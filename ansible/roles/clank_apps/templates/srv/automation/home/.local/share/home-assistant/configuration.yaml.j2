homeassistant:
  external_url: https://{{ automation_domain }}
  packages: !include_dir_named packages
default_config:
recorder:
  purge_keep_days: 7
  commit_interval: 30
automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml
lovelace:
  dashboards:
    dashboard-kb:
      mode: yaml
      title: KB
      icon: mdi:home-assistant
      filename: dashboards/kb.yaml
ingress:
  matter:
    title: Matter
    icon: mdi:chip
    require_admin: true
    url: http://gateway:{{ automation_matter_api_port }}
