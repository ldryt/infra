[Match]
Name=wlan0

[Link]
RequiredForOnline=no

[Network]
Address=192.168.50.1/24
Address=fd3f:434c:414e:4b00::1/64
ConfigureWithoutCarrier=yes
DHCPServer=yes
IPv6AcceptRA=no
IPv6SendRA=yes
IPMasquerade=no
MulticastDNS=no
LLMNR=no

[DHCPServer]
EmitRouter=no
EmitDNS=no

{% for device in automation_wifi_devices %}
[DHCPServerStaticLease]
MACAddress={{ device.mac }}
Address={{ device.ip }}

{% endfor %}
[IPv6SendRA]
RouterLifetimeSec=0
EmitDNS=no

[IPv6Prefix]
Prefix=fd3f:434c:414e:4b00::/64
