[Unit]
Description=Zigbee and Thread radio stack
RequiresMountsFor=/srv/automation
BindsTo=srv-automation.mount
ConditionPathIsMountPoint=/srv/automation

[Container]
GlobalArgs=--root /srv/automation/radio/containers --runroot /run/clank-multipan
Image={{ automation_images.multipan }}
ContainerName=clank-multipan
Network=host
AddCapability=IPC_LOCK NET_ADMIN NET_RAW
AddDevice=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0:/dev/ttyMultipan
AddDevice=/dev/net/tun
Volume=/srv/automation/radio/data:/data
Volume=/srv/automation/radio/start:/usr/local/bin/multipan-start:ro
Entrypoint=/usr/local/bin/multipan-start
Environment=DEVICE=/dev/ttyMultipan BAUDRATE=230400 EZSP_LISTEN_PORT={{ automation_ezsp_port }}
Environment=BACKBONE_IF=eth0
NoNewPrivileges=true
StopTimeout=30

[Service]
Environment=TMPDIR=/srv/automation/radio/tmp
Restart=on-failure
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
